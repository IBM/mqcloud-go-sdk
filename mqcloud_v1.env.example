# Template for the integration and example tests.
#
# Copy this file to "mqcloud_v1.env" in the repository root and replace the placeholder values:
#   cp mqcloud_v1.env.example mqcloud_v1.env
# The tests read "../mqcloud_v1.env" (relative to the mqcloudv1 directory). "*.env" is git-ignored, so your
# credentials will not be committed. Never put real credentials in this example file.
#
# Tests that need a value which is not set are skipped, with a message naming the missing variable.

# ---------------------------------------------------------------------------------------------------------------
# Service instance and certificates (required)
# ---------------------------------------------------------------------------------------------------------------
# ID of the deployment service instance the tests create queue managers in.
MQCLOUD_SERVICE_INSTANCE_DEPLOYMENT_GUID=<deployment service instance ID>

# Paths to the PEM files uploaded by the certificate tests.
# The trust store file is an individual certificate. The key store file is a combined private key and certificate.
MQCLOUD_TRUST_STORE_FILE_PATH=/path/to/certificates/truststore.pem
MQCLOUD_KEY_STORE_FILE_PATH=/path/to/certificates/keystore.pem

# ---------------------------------------------------------------------------------------------------------------
# Optional: queue manager versions
# ---------------------------------------------------------------------------------------------------------------
# Uncomment to test specific versions. If not set, the tests work the values out from the service.
# MQCLOUD_VERSION should be one version before the latest, so that an upgrade is possible.
# MQCLOUD_VERSION_UPGRADE should be the latest version available on the stack.
# The stack versions need updating to match.
#MQCLOUD_VERSION=9.4.2_1
#MQCLOUD_VERSION_UPGRADE=9.4.2_2

# ---------------------------------------------------------------------------------------------------------------
# Optional: virtual private endpoint gateway tests
# ---------------------------------------------------------------------------------------------------------------
# MQCLOUD_SERVICE_INSTANCE_CAPACITY_GUID and MQCLOUD_TARGET_CRN must be set for the gateway tests to run,
# otherwise those tests are skipped.
MQCLOUD_SERVICE_INSTANCE_CAPACITY_GUID=<capacity service instance ID>
# CRN of the target capacity service instance, used when creating the gateway.
MQCLOUD_TARGET_CRN=<target capacity service instance CRN>
# CRN of the trusted profile used for the gateway tests.
MQCLOUD_TRUSTED_PROFILE=<trusted profile CRN>

